<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="cmis_web.CmisActions">
        <div class="btn-group" role="group">
            <button
                type="button"
                t-if="allowableActions.canGetContentStream"
                title="Download"
                class="btn btn-outline-primary btn-sm"
                t-on-click="onClickDownload"
            >
                <i class="fa fa-download"/>
            </button>
            <button
                type="button"
                t-if="allowableActions.canGetContentStream"
                title="Preview"
                class="btn btn-outline-primary btn-sm"
                t-on-click="onClickPreview"
            >
                <i class="fa fa-eye"/>
            </button>
            <Dropdown position="'bottom-end'">
                <button
                    type="button"
                    title="More actions"
                    class="btn btn-outline-primary btn-sm"
                    t-on-click="(ev) => ev.stopPropagation()">
                    <i class="fa fa-align-justify"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem t-if="allowableActions.canUpdateProperties" onSelected="() => this.onRename()">
                    Rename
                    </DropdownItem>
                    <DropdownItem
                        t-if="allowableActions.canSetContentStream and !allowableActions.canCheckIn"
                        onSelected="() => this.onUpdate()">
                        Update
                    </DropdownItem>
                    <t t-if="allowableActions.canDeleteObject">
                        <div class="dropdown-divider"/>
                        <DropdownItem onSelected="() => this.onDelete()">
                            Delete
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>
        </div>
    </t>
</templates>
